{
  "name": "recordplease",
  "productName": "RecordPlease",
  "version": "1.3.0",
  "description": "RecordPlease: record your lessons with a voice-following teleprompter that stays out of your video",
  "author": "Luis Bei",
  "license": "MIT",
  "main": "app.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "com.luis.ghostprompter",
    "productName": "RecordPlease",
    "artifactName": "RecordPlease-Setup-${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "app.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "extraFiles": [
      { "from": "LICENSE", "to": "LICENSE.txt" },
      { "from": "THIRD_PARTY_NOTICES.md", "to": "THIRD_PARTY_NOTICES.md" },
      { "from": "PRIVACY.md", "to": "PRIVACY.md" }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true,
      "loadBrowserProcessSpecificV8Snapshot": false
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RecordPlease",
      "uninstallDisplayName": "RecordPlease",
      "deleteAppDataOnUninstall": false,
      "license": "build/installer-license.txt"
    }
  },
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "vosk-browser": "^0.0.8"
  }
}
